# Create a bot via @BotFather. Keep this file private.
BOT_TOKEN=

# Telegram numeric user IDs for administrators, comma-separated.
ADMIN_IDS=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key safe and backed up. Losing it means encrypted server passwords cannot be recovered.
FERNET_KEY=

# Payment instructions shown to the customer after an admin requests payment.
PAYMENT_INSTRUCTIONS=Переведите оплату по реквизитам, которые вам сообщит администратор.